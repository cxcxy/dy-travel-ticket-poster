{
  "version": "2.0",
  "defaults": {
    "strength": "balanced",
    "lighting": "soft_daylight",
    "shadow": "premium_float",
    "subject_preservation": "strict",
    "visual_priority": "subject-first",
    "complexity": "low-medium",
    "contrast": "low",
    "texture": "subtle"
  },
  "global_rules": [
    "背景永远服务于主体，不抢主体视觉层级。",
    "默认保持主体内容、人物、文字、日期、条形码、比例和版式不变。",
    "背景优化只作用于材质、纹理、光线、阴影、纵深、色彩和氛围。",
    "保持低饱和、真实材质、微弱色差、自然阴影和克制光线。",
    "禁止霓虹边缘、过量渐变、过强光晕、过饱和、过强 HDR、大面积发光、过量颗粒和塑料感。",
    "主体与背景必须保持足够明度差，保证主体一眼成为视觉焦点。"
  ],
  "strength_presets": {
    "subtle": 0.25,
    "balanced": 0.5,
    "strong": 0.75
  },
  "lighting_presets": {
    "soft_daylight": {"direction": "top-left", "softness": 0.9, "intensity": 0.3, "temperature": "neutral-warm"},
    "afternoon_sun": {"direction": "upper-right", "softness": 0.55, "intensity": 0.6, "temperature": "warm"},
    "diffused_window": {"direction": "side", "softness": 0.8, "intensity": 0.4, "temperature": "neutral"},
    "gallery_light": {"direction": "centered-top", "softness": 0.95, "intensity": 0.3, "temperature": "neutral"},
    "center_spotlight": {"direction": "center", "softness": 1.0, "intensity": 0.4, "temperature": "neutral-warm"},
    "overcast_soft": {"direction": "ambient", "softness": 1.0, "intensity": 0.25, "temperature": "neutral"}
  },
  "shadow_presets": {
    "flat": {"distance": 1, "blur": 12, "opacity": 0.08},
    "subtle_float": {"distance": 8, "blur": 28, "opacity": 0.15},
    "premium_float": {"distance": 14, "blur": 42, "opacity": 0.2},
    "architectural": {"distance": 24, "blur": 55, "opacity": 0.22}
  },
  "subject_preservation_modes": {
    "strict": "Preserve the original subject exactly. Do not redesign the ticket, card, poster, product or photo. Keep original proportions, typography, people, faces, layout, dates, barcode, image content and key visual elements unchanged.",
    "balanced": "Preserve all important subject content and information. Allow only restrained edge cleanup and natural integration of subject lighting and shadow.",
    "creative": "Preserve identity and essential information, but allow limited visual integration between subject and background when the user explicitly requests it."
  },
  "negative_prompt": [
    "no neon",
    "no heavy gradients",
    "no glossy plastic",
    "no excessive HDR",
    "no distracting decoration",
    "no oversaturated colors",
    "no artificial glowing edges",
    "no busy background"
  ],
